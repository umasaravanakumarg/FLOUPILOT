# Omit both variables to use the isolated browser-local demo.
# When either is set, both are required and the server fails closed if incomplete.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional server-side OpenAI-compatible adapter. Leave all unset for deterministic answers.
FLOU_AI_BASE_URL=
FLOU_AI_API_KEY=
FLOU_AI_MODEL=
